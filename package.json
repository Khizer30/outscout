{
  "name": "outscout",
  "description": "Geo-targeted B2B lead generation and outreach platform",
  "private": true,
  "author": {
    "name": "Syed Muhammad Khizer",
    "email": "syed.khizer30@gmail.com"
  },
  "scripts": {
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.4",
    "typescript": "5.9.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
