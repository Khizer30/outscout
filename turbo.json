{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "PORT",
    "NODE_ENV",
    "CORS_ORIGINS",
    "ENCRYPTION_KEY",
    "JWT_SECRET",
    "JWT_EXPIRE_TIME",
    "JWT_REFRESH_SECRET",
    "JWT_REFRESH_EXPIRE_TIME",
    "DATABASE_URL",
    "GOOGLE_PLACES_API_KEY",
    "GEMINI_API_KEY",

    "NEXT_PUBLIC_BACKEND_URL",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
