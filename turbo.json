{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "nestjs#build": {
      "dependsOn": ["^build"],
      "env": [
        "PORT",
        "METRICS_PORT",
        "NODE_ENV",
        "LOG_LEVEL",
        "CORS_ORIGINS",
        "FRONTEND_URL",
        "ENCRYPTION_KEY",
        "JWT_SECRET",
        "JWT_EXPIRE_TIME",
        "JWT_REFRESH_SECRET",
        "JWT_REFRESH_EXPIRE_TIME",
        "DATABASE_URL",
        "GOOGLE_PLACES_API_KEY",
        "GEMINI_API_KEY",
        "GEMINI_MODEL",
        "BREVO_SENDER_NAME",
        "BREVO_SENDER_EMAIL",
        "BREVO_API_KEY",
        "CLOUDINARY_CLOUD",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_USERNAME",
        "REDIS_PASSWORD",
        "REDIS_TLS",
        "AXIOM_DATASET",
        "AXIOM_TOKEN",
        "GRAFANA_ADMIN_USER",
        "GRAFANA_ADMIN_PASSWORD"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "drizzle/**"]
    },
    "nextjs#build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_BACKEND_URL", "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
